# GUSTO · variáveis de ambiente (copie para .env no desenvolvimento local)
# Na VPS: /opt/gusto[-teste]/.env é montado pelo deploy a partir de
#   .env.gerado   → criado por deploy/setup-vps.sh (segredos de infraestrutura; nunca passam pelo GitHub)
#   .env.segredos → secret SERVIDOR_ENV do GitHub (chaves de IA, PSP, contatos LGPD)

# ---------- infraestrutura (gerado na VPS) ----------
COMPOSE_PROJECT_NAME=gusto
APP_IMAGE=gusto-app
AMBIENTE=producao               # producao | teste
DOMINIO=gusto.m3d.pro
PORTA=3301                      # porta local (127.0.0.1) que o Nginx do host usa
BASE_PATH=                      # "" em produção, "/teste" em homologação
COOKIE_NAME=gusto_sid           # gusto_sid_teste em homologação
PUBLIC_URL=http://localhost:3301
COOKIE_SECURE=0                 # 1 em produção (HTTPS)
BACKUP_DIR=./backups
POSTGRES_SUPERUSER_PASSWORD=troque-por-uma-senha-longa
GUSTO_DB_PASSWORD=troque0por0uma0senha0longa
GUSTO_ROOT_PASSWORD=troque-no-1o-acesso      # só usado na 1ª migração
CODE_SECRET=troque-por-32-ou-mais-caracteres-aleatorios
WEBHOOK_SECRET=troque
TURN_SECRET=troque

# ---------- aplicação (SERVIDOR_ENV no GitHub) ----------
PAYMENTS_PROVIDER=mock
PSP_API_URL=
PSP_API_KEY=
# IA (failsafe em ordem; várias chaves separadas por vírgula; chaves com "…" são ignoradas)
IA_ORDEM=gemini,anthropic,openai
IA_GEMINI_KEYS=
IA_ANTHROPIC_KEYS=              # precisa começar com sk-ant-api
IA_OPENAI_KEYS=
IA_OPENAI_URL=                  # opcional: endpoint compatível com OpenAI
IA_GEMINI_MODELO=
IA_ANTHROPIC_MODELO=
IA_OPENAI_MODELO=
# Contas (v0.8): cadastro aberto e entrada com provedores externos — guia em docs/CONTAS-EXTERNAS.md
REGISTRO_ABERTO=1               # 0 = só o root cria contas
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_MICROSOFT_ID=
OAUTH_MICROSOFT_SECRET=
OAUTH_MICROSOFT_TENANT=common   # common = contas pessoais e corporativas
OAUTH_X_ID=
OAUTH_X_SECRET=
OAUTH_APPLE_ID=                 # Services ID (ex.: pro.m3d.gusto.web)
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_KEY=                # conteúdo do .p8 numa linha, com \n no lugar das quebras
# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=                       # preenchido pelo setup-vps.sh --turn
# LGPD
LGPD_CONTROLADOR=M3D.pro
LGPD_DPO_CONTATO=               # e-mail ou página do encarregado, exibido na janela Privacidade
CHAT_RETENTION_DAYS=30
